<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">catalogai_enrichment_form.catalogai_enrichment_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Enrichment Details</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back">
                <url path="*/*/index"/>
                <class>back</class>
                <label translate="true">Back</label>
            </button>
            <button name="save" class="MageOS\CatalogDataAI\Block\Adminhtml\Enrichment\SaveButton"/>
        </buttons>
        <namespace>catalogai_enrichment_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>catalogai_enrichment_form.catalogai_enrichment_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="catalogai_enrichment_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="catalogai/enrichment/save"/>
        </settings>
        <dataProvider class="MageOS\CatalogDataAI\Model\Enrichment\DataProvider" name="catalogai_enrichment_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general" sortOrder="10">
        <settings>
            <label translate="true">General Information</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="entity_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
            </settings>
        </field>
        <field name="product_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Product ID</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="attribute_code" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Attribute Code</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="store_id" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Store ID</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="prompt_hash" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Prompt Hash</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="created_at" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Created At</label>
                <disabled>true</disabled>
            </settings>
        </field>
    </fieldset>
    <fieldset name="content" sortOrder="20">
        <settings>
            <label translate="true">Content</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="parsed_prompt" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Parsed Prompt</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="generated_value" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Generated Value</label>
                <disabled>true</disabled>
            </settings>
        </field>
        <field name="applied_value" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Applied Value</label>
                <notice translate="true">Edit this field to override the generated value before approving.</notice>
            </settings>
        </field>
    </fieldset>
    <fieldset name="review" sortOrder="30">
        <settings>
            <label translate="true">Review</label>
            <collapsible>true</collapsible>
            <opened>true</opened>
        </settings>
        <field name="status" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Status</label>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="MageOS\CatalogDataAI\Ui\Component\Listing\Column\Status\Options"/>
                    </settings>
                </select>
            </formElements>
        </field>
        <field name="admin_notes" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Admin Notes</label>
                <notice translate="true">Optional notes about this review decision.</notice>
            </settings>
        </field>
    </fieldset>
</form>
