<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="catalogai_product_enrichment" resource="default" engine="innodb" comment="CatalogAI Product Enrichment Queue">
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Entity ID"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Product ID"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" default="0" comment="Store ID"/>
        <column xsi:type="varchar" name="attribute_code" length="255" nullable="false" comment="Target Attribute Code"/>
        <column xsi:type="varchar" name="prompt_hash" length="64" nullable="false" comment="SHA-256 Hash of Composite Input"/>
        <column xsi:type="text" name="parsed_prompt" nullable="true" comment="Full Prompt for Admin Reference"/>
        <column xsi:type="text" name="generated_value" nullable="true" comment="Raw AI Output"/>
        <column xsi:type="text" name="applied_value" nullable="true" comment="Value After Admin Edit"/>
        <column xsi:type="varchar" name="status" length="20" nullable="false" default="pending" comment="Review Status"/>
        <column xsi:type="text" name="admin_notes" nullable="true" comment="Optional Admin Review Notes"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="FK_CATALOGAI_ENRICHMENT_PRODUCT_ID" table="catalogai_product_enrichment" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <constraint xsi:type="unique" referenceId="UNQ_CATALOGAI_ENRICHMENT_HASH_ATTR_STORE">
            <column name="prompt_hash"/>
            <column name="attribute_code"/>
            <column name="store_id"/>
        </constraint>

        <index referenceId="IDX_CATALOGAI_ENRICHMENT_PRODUCT_STORE" indexType="btree">
            <column name="product_id"/>
            <column name="store_id"/>
        </index>
        <index referenceId="IDX_CATALOGAI_ENRICHMENT_STATUS" indexType="btree">
            <column name="status"/>
        </index>
        <index referenceId="IDX_CATALOGAI_ENRICHMENT_CREATED_AT" indexType="btree">
            <column name="created_at"/>
        </index>
    </table>
</schema>
